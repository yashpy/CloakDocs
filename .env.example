# ─────────────────────────────────────────────────────────────────────────────
# CloakDocs environment template.
#   1. cp .env.example .env
#   2. Fill in the values from Firebase console → Project settings → Your apps → Web app
#   3. NEVER commit .env (it is git-ignored). Vite only exposes variables prefixed VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web app config ──────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase App Check (required for Firebase AI Logic) ──────────────────────
# For judges / local development: paste a debug token registered under
#   Firebase console → App Check → Apps → (your web app) → Manage debug tokens
# Use the literal value "true" to let the SDK print a fresh token in the
# browser console on first load, then register that token and paste it here.
# Do NOT commit a real debug token and do NOT deploy a build that contains one.
VITE_APPCHECK_DEBUG_TOKEN=

# Production attestation (used when no debug token is set).
# Provider: "v3" (reCAPTCHA v3) or "enterprise" (reCAPTCHA Enterprise)
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_PROVIDER=v3

# ── Optional overrides ───────────────────────────────────────────────────────
# Cloud fallback model used by Firebase AI Logic. Leave empty to use the
# Remote Config value `cloud_model` (default: gemini-3.5-flash-lite).
VITE_CLOUD_MODEL=
